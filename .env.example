# ==========================================
# DISCORD BOT CREDENTIALS & OWNER ACCESS
# ==========================================
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_client_id_here
# Optional: Specify GUILD_ID for instant slash command registration in development
GUILD_ID=

# Your personal Discord User ID (Required for DM training, hotpatches, and live knowledge editing)
OWNER_ID=

# ==========================================
# OPENROUTER AI CONFIGURATION
# ==========================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OX Alpha model on OpenRouter (stealth/ox-alpha)
OPENROUTER_MODEL=stealth/ox-alpha
# Optional custom site URL/Name for OpenRouter analytics ranking
OPENROUTER_SITE_URL=https://discord.gg/your-server
OPENROUTER_SITE_NAME=Support Bot

# ==========================================
# DISCORD SERVER / TICKET SETTINGS
# ==========================================
# ID of the category where new tickets should be opened (Optional - creates at root if empty)
TICKET_CATEGORY_ID=

# ID of the Support/Staff Role that should have access to tickets
SUPPORT_ROLE_ID=

# ID of the channel where closed ticket transcripts should be logged
TRANSCRIPT_CHANNEL_ID=

# Hardcoded initial greeting message when a ticket is opened
TICKET_GREETING_MESSAGE="Hello {user}, thank you for reaching out! 👋\nPlease describe your issue or question in detail, and our AI support assistant will be right with you."

# Bot embed theme color (Hex code)
EMBED_COLOR=#5865F2
