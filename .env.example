# ==========================================
# DISCORD BOT CREDENTIALS & OWNER ACCESS
# ==========================================
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_client_id_here
# Optional: Specify GUILD_ID for instant slash command registration in development
GUILD_ID=

# Your personal Discord User ID (Required for DM training, hotpatches, and live knowledge editing)
OWNER_ID=

# ==========================================
# AI PROVIDER SWITCHER
# ==========================================
# Set provider explicitly ('openrouter' or 'nvidia'), or let the 1/0 switches below decide:
# AI_PROVIDER=openrouter

# ==========================================
# 1. OPENROUTER AI CONFIGURATION
# ==========================================
OPENROUTER_ENABLED=1
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=stealth/ox-alpha
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional custom site URL/Name for OpenRouter analytics ranking
OPENROUTER_SITE_URL=https://discord.gg/your-server
OPENROUTER_SITE_NAME=Support Bot

# ==========================================
# 2. NVIDIA NIM AI CONFIGURATION
# ==========================================
# Set NVIDIA_ENABLED=1 and OPENROUTER_ENABLED=0 to switch to NVIDIA NIM
NVIDIA_ENABLED=0
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ==========================================
# DISCORD SERVER / TICKET SETTINGS
# ==========================================
# ID of the category where new tickets should be opened (Optional - creates at root if empty)
TICKET_CATEGORY_ID=

# ID of the Support/Staff Role that should have access to tickets
SUPPORT_ROLE_ID=

# ID of the channel where closed ticket transcripts should be logged
TRANSCRIPT_CHANNEL_ID=

# Hardcoded initial greeting message when a ticket is opened
TICKET_GREETING_MESSAGE="Hello {user}, thank you for reaching out! 👋\nPlease describe your issue or question in detail, and our AI support assistant will be right with you."

# Bot embed theme color (Hex code)
EMBED_COLOR=#5865F2

# ==========================================
# VERTEX PANEL INTEGRATION
# ==========================================
# The public URL of your Vertex panel (no trailing slash)
PANEL_URL=https://your-panel.example.com

# Must match BOT_API_SECRET in the panel's .env file
# This is how the bot authenticates to the panel's /api/bot/* endpoints
PANEL_BOT_SECRET=your_shared_bot_api_secret_here

# How long (ms) to wait for a panel API response before giving up (default 5000)
PANEL_TIMEOUT_MS=5000

# ==========================================
# HAPPY HOUR VPS EVENT SYSTEM
# ==========================================
# Channel ID where happy hour announcements are posted
HAPPY_HOUR_CHANNEL_ID=your_announcement_channel_id

# Set to 0 to disable the happy hour scheduler entirely
HAPPY_HOUR_ENABLED=1

# Optional: Role ID to @mention when a happy hour fires (leave blank for no ping)
HAPPY_HOUR_PING_ROLE_ID=

# Min/max hours between events (randomly chosen from this range)
HAPPY_HOUR_MIN_DELAY_HOURS=2
HAPPY_HOUR_MAX_DELAY_HOURS=22

# How long (minutes) a happy hour lasts before auto-expiring (default 60)
HAPPY_HOUR_DURATION_MINUTES=60
